# Environment Variables Template
# Copy this file to .env and fill in your values

# Database Configuration
POSTGRES_DB=samudra_sachet
POSTGRES_USER=samudra_user
POSTGRES_PASSWORD=your-secure-password-here

# Redis Configuration
REDIS_URL=redis://redis:6379

# Backend Configuration
SECRET_KEY=your-very-secure-secret-key-here
ENVIRONMENT=production
LOG_LEVEL=info

# API Configuration
API_URL=https://api.samudra-sachet.com/api/v1
WS_URL=wss://api.samudra-sachet.com/ws

# Frontend Configuration
VITE_API_URL=https://api.samudra-sachet.com/api/v1
VITE_WS_URL=wss://api.samudra-sachet.com/ws
VITE_SENTRY_DSN=your-sentry-dsn-here
VITE_GA_ID=your-google-analytics-id-here

# Monitoring Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-grafana-password-here

# External Services
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=your-google-analytics-id-here

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_PATH=/app/uploads

# Security Configuration
CORS_ORIGINS=https://samudra-sachet.com,https://www.samudra-sachet.com
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRE_MINUTES=30

# Email Configuration (if using email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# Social Media API Keys
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# AI/ML Services
OPENAI_API_KEY=your-openai-api-key
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key

# Map Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# CDN Configuration
CDN_URL=https://cdn.samudra-sachet.com
CDN_BUCKET=samudra-sachet-assets

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=samudra-sachet-backups
BACKUP_S3_REGION=us-east-1

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600  # 1 hour in seconds

# Cache Configuration
CACHE_TTL=1800  # 30 minutes in seconds
CACHE_MAX_SIZE=1000

# Logging Configuration
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Performance Configuration
MAX_WORKERS=4
WORKER_TIMEOUT=30
WORKER_MEMORY_LIMIT=512MB

